---
import { getMilestoneAge, formatMilestoneDate } from "../utils/date";
import { slugify } from "../utils/slugify";

interface Props {
  milestone: any;
}

const { milestone: m } = Astro.props;

function getCategoryClass(cat: string) {
  const map: Record<string, string> = {
    Firsts: "cat-firsts",
    Monthly: "cat-monthly",
    Growth: "cat-growth",
    Funny: "cat-funny",
    Health: "cat-health",
    Celebration: "cat-celebration",
  };
  return map[cat] || "cat-firsts";
}
---

<div class="milestone-preview-card fade-up">
  <span class={`mpc-category ${getCategoryClass(m.data.category)}`}
    >{m.data.category}</span
  >
  <div class="mpc-title">{m.data.emoji} {m.data.title}</div>
  <div class="mpc-desc">{m.data.desc}</div>
  <div class="mpc-footer">
    <div class="mpc-age">{getMilestoneAge(m.data.date)}</div>
    <div class="mpc-date">{formatMilestoneDate(m.data.date)}</div>
  </div>

  <template class="milestone-modal-template">
    <div class="modal-img" style={`background:${m.data.color}`}>
      {m.data.emoji}
    </div>
    <a
      href={`/milestones/${slugify(m.data.title)}`}
      class="modal-link"
      aria-label="View single page">🔗</a
    >
    <div class="modal-body">
      <span
        class={`mpc-category ${getCategoryClass(m.data.category)} modal-category`}
        >{m.data.category}</span
      >
      <h2 class="modal-title">{m.data.title}</h2>
      <div class="modal-age-date">
        <span>👶 {getMilestoneAge(m.data.date)}</span>
        <span>📅 {formatMilestoneDate(m.data.date)}</span>
      </div>
      <div class="modal-desc">{m.data.desc}</div>
      <div class="modal-full-story">{m.data.story}</div>
    </div>
  </template>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const cards = document.querySelectorAll(".milestone-preview-card");
    cards.forEach((card) => {
      if (card.classList.contains("has-popup-listener")) return;
      card.classList.add("has-popup-listener");

      card.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest(".mpc-category")) return;

        const template = card.querySelector(
          ".milestone-modal-template",
        ) as HTMLTemplateElement;
        if (!template) return;

        const isCelebration =
          card.querySelector(".mpc-category")?.textContent?.trim() ===
          "Celebration";

        if (typeof (window as any).milestoneModal_open === "function") {
          (window as any).milestoneModal_open(template.innerHTML);

          if (isCelebration) {
            import("https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/+esm").then(
              (confettiModule) => {
                const confetti = confettiModule.default || confettiModule;
                confetti({
                  particleCount: 150,
                  spread: 70,
                  origin: { y: 0.6 },
                });
              },
            );
          }
        }
      });
    });
  });
</script>
