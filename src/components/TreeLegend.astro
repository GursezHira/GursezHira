---
/**
 * TreeLegend.astro
 * 
 * Legend for the family tree branches.
 */
import type { Branch } from '../types/family-tree';

interface Props {
  branches: Branch[];
}

const { branches } = Astro.props;
---

<div class="ft-legend fade-up" aria-label="Legend">
  {branches.map(b => (
    <div
      class="ft-legend-item"
      onclick={`toggleBranchSpotlight('${b.id}', this)`}
      style="cursor:pointer; transition: opacity 0.3s;"
      title="Click to spotlight this branch"
    >
      <span class={`ft-dot ft-dot--${b.id}`}></span>
      {b.label}
      <span class="ft-legend-count">{b.nodes.length}</span>
    </div>
  ))}
  <div class="ft-legend-item" style="transition: opacity 0.3s;">
    <span class="ft-dot ft-dot--gursez"></span> Our Little Star
  </div>
  <div class="ft-legend-item" style="transition: opacity 0.3s;">
    <span class="ft-dot ft-dot--line"></span> Connected by Love
  </div>
</div>
