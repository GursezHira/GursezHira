---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { 
  title, 
  description = "Every yawn, every giggle, every tiny milestone — lovingly captured and kept forever. Gursez Singh Hira's Memory Book.",
  image = "/og/home.png",
  type = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Gursez Singh Hira",
  "url": "https://gursez.hira.im",
  "gender": "male",
  "birthDate": "2026-01-13",
  "description": "Gursez Singh Hira's personal memory book documenting his life milestones and stories."
};
---

<!-- Primary Meta Tags -->
<title>{title} | Gursez Singh Hira</title>
<meta name="title" content={`${title} | Gursez Singh Hira`} />
<meta name="description" content={description} />
<meta name="author" content="Mum & Dad" />

<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={`${title} | Gursez Singh Hira`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={`${title} | Gursez Singh Hira`} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="Gursez Singh Hira's Stories" href="/rss.xml" />

<!-- Schema.org -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
<link rel="manifest" href="/favicon/site.webmanifest" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=Pinyon+Script&display=swap" rel="stylesheet" />
