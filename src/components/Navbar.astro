---
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isMilestones = pathname.startsWith('/milestones');
const isStories = pathname.startsWith('/stories');
const isTree = pathname.startsWith('/family-tree');
---

<nav role="navigation" aria-label="Main navigation">
  <div class="nav-logo"><a href="/">Little Gursez's Book</a></div>
  <ul class="nav-links">
    <li><a href="/" class={isHome ? 'active' : ''}><span class="nav-icon"></span> Home</a></li>
    <li><a href="/milestones" class={isMilestones ? 'active' : ''}><span class="nav-icon"></span> Milestones</a></li>
    <li><a href="/stories" class={isStories ? 'active' : ''}><span class="nav-icon"></span> Stories</a></li>
    <li><a href="/family-tree" class={isTree ? 'active' : ''}><span class="nav-icon"></span> Family Tree</a></li>
    <li>
      <button id="themeToggle" class="theme-toggle" aria-label="Toggle dark mode">
        <span class="icon-light">☀️</span>
        <span class="icon-dark">🌙</span>
      </button>
    </li>
  </ul>
  <div class="nav-mobile-controls">
    <button id="mobileThemeToggle" class="theme-toggle mobile-theme-toggle" aria-label="Toggle dark mode">
      <span class="icon-light">☀️</span>
      <span class="icon-dark">🌙</span>
    </button>
    <button class="nav-hamburger" aria-label="Open menu" onclick="toggleMobileMenu()">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true">
  <div class="mobile-menu-header">
    <button class="mobile-menu-close" onclick="toggleMobileMenu()" aria-label="Close menu">✕</button>
    <button id="mobileMenuThemeToggle" class="theme-toggle mobile-menu-theme" aria-label="Toggle dark mode">
      <span class="icon-light">☀️</span>
      <span class="icon-dark">🌙</span>
    </button>
  </div>
  <a href="/" onclick="toggleMobileMenu()">Home</a>
  <a href="/milestones" onclick="toggleMobileMenu()">Milestones</a>
  <a href="/stories" onclick="toggleMobileMenu()">Stories</a>
  <a href="/family-tree" onclick="toggleMobileMenu()">Family Tree</a>
</div>

<script>
  function setupThemeToggle() {
    const themeButtons = [
      document.getElementById('themeToggle'),
      document.getElementById('mobileThemeToggle'),
      document.getElementById('mobileMenuThemeToggle')
    ].filter((btn): btn is HTMLElement => btn !== null);
    
    if (themeButtons.length === 0) return;
    
    const updateButtonIcons = (isDark: boolean) => {
      themeButtons.forEach(btn => {
        const iconLight = btn.querySelector('.icon-light') as HTMLElement;
        const iconDark = btn.querySelector('.icon-dark') as HTMLElement;
        if (iconLight) iconLight.style.display = isDark ? 'inline' : 'none';
        if (iconDark) iconDark.style.display = isDark ? 'none' : 'inline';
      });
    };
    
    const isDark = document.documentElement.classList.contains('dark-mode');
    updateButtonIcons(isDark);
    
    themeButtons.forEach(btn => {
      // Use a named function to avoid double-binding if needed, 
      // though astro:page-load handles cleanup for bundled scripts usually.
      btn.onclick = () => {
        const element = document.documentElement;
        element.classList.toggle('dark-mode');
        const isDarkNow = element.classList.contains('dark-mode');
        document.cookie = `theme=${isDarkNow ? 'dark' : 'light'}; path=/; max-age=31536000`;
        updateButtonIcons(isDarkNow);
      };
    });
  }
  
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

<script is:inline>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobileMenu');
    const hamburger = document.querySelector('.nav-hamburger');
    menu.classList.toggle('open');
    if (hamburger) {
      hamburger.classList.toggle('open');
    }
    document.body.style.overflow = menu.classList.contains('open') ? 'hidden' : '';
  }
  
  // Close mobile menu when clicking on a link
  document.addEventListener('DOMContentLoaded', () => {
    const mobileLinks = document.querySelectorAll('.mobile-menu a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        const menu = document.getElementById('mobileMenu');
        const hamburger = document.querySelector('.nav-hamburger');
        menu.classList.remove('open');
        if (hamburger) {
          hamburger.classList.remove('open');
        }
        document.body.style.overflow = '';
      });
    });
  });
</script>
