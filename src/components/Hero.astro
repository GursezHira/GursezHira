---
---
<div class="container">
  <section class="hero" aria-label="Welcome">
    <div class="hero-text">
      <span class="hero-eyebrow">Welcome to the world,</span>
      <h1 class="hero-name">
        Gursez<span>Singh Hira</span>
      </h1>
      <p class="hero-tagline">Every yawn, every giggle, every tiny milestone — lovingly captured and kept forever. This is your story from the very first breath.</p>
      <div class="hero-buttons">
        <a href="/milestones" class="btn btn-primary">✦ My Milestones</a>
        <a href="/stories" class="btn btn-outline">My Stories</a>
        <a href="/family-tree" class="btn btn-soft">🌳 My Roots</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-photo-wrap">
        <div class="hero-photo-main">
          <img src="/image.png" alt="Gursez Singh Hira"/>
        </div>
        <div class="hero-badge hero-badge-born">
          <span class="badge-icon">💙</span>
          <div class="badge-text">
            <span class="badge-value">Cuddles</span>
          </div>
        </div>
        <div class="hero-badge hero-badge-days">
          <span class="badge-num" id="daysCount">—</span>
          <div class="badge-tiny">Days of Joy</div>
        </div>
        <div class="hero-decoration"><div class="deco-ring"></div></div>
        <div class="hero-decoration deco-dots"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
      </div>
    </div>
  </section>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    // Jan 13, 2026 at 01:42 AM NZST (UTC+13)
    // 01:42 NZST = 12:42 UTC on Jan 12, 2026
    const born = new Date('2026-01-12T12:42:00Z');

    const daysEl = document.getElementById('daysCount');
    const timeEl = document.getElementById('timeCount');

    function update() {
      const now = new Date();
      if (now < born) return;

      const diff = now.getTime() - born.getTime();

      const totalSeconds = Math.floor(diff / 1000);
      const days    = Math.floor(totalSeconds / (60 * 60 * 24));
      const hours   = Math.floor((totalSeconds % (60 * 60 * 24)) / (60 * 60));
      const minutes = Math.floor((totalSeconds % (60 * 60)) / 60);
      const seconds = totalSeconds % 60;

      const pad = (n: number) => String(n).padStart(2, '0');

      if (daysEl) daysEl.innerHTML = days.toString();
      if (timeEl) timeEl.innerHTML = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
    }

    update();
    setInterval(update, 1000);
  });
</script>