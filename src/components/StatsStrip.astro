---
---
<div class="stats-strip" aria-label="Baby stats">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item fade-up">
        <div class="stat-icon">📅</div>
        <span class="stat-label">Born on</span>
        <span class="stat-val">Jan 13, 2026</span>
      </div>
      <div class="stat-item fade-up" style="transition-delay:0.2s">
        <div class="stat-icon">🕐</div>
        <span class="stat-label">Born At</span>
        <span class="stat-val">01:42 am</span>
      </div>
      <div class="stat-item fade-up" style="transition-delay:0.3s">
        <div class="stat-icon">🏙️</div>
        <span class="stat-label">Born in</span>
        <span class="stat-val">Auckland</span>
      </div>
      <div class="stat-item fade-up" style="transition-delay:0.1s">
        <div class="stat-icon">👦</div>
        <span class="stat-label">Born as</span>
        <span class="stat-val">Boy</span>
      </div>
    </div>
  </div>
</div>
