---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { 
  title, 
  description = "Every yawn, every giggle, every tiny milestone — lovingly captured and kept forever. Gursez Singh Hira's Memory Book.",
  image = "/og/home.png",
  type = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Gursez Singh Hira",
  "url": "https://gursez.hira.im",
  "gender": "male",
  "birthDate": "2026-01-13",
  "description": "Gursez Singh Hira's personal memory book documenting his life milestones and stories."
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Primary Meta Tags -->
  <title>{title} | Gursez Singh Hira</title>
  <meta name="title" content={`${title} | Gursez Singh Hira`} />
  <meta name="description" content={description} />
  <meta name="author" content="Mum & Dad" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`${title} | Gursez Singh Hira`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={`${title} | Gursez Singh Hira`} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={ogImageURL} />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="Gursez Singh Hira's Stories" href="/rss.xml" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
  <link rel="manifest" href="/favicon/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=Pinyon+Script&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- FLOATING DECORATIONS -->
  <div class="deco-layer" aria-hidden="true">
    <div class="deco-orb orb-1"></div>
    <div class="deco-orb orb-2"></div>
    <div class="deco-orb orb-3"></div>
    <div class="deco-orb orb-4"></div>
    <div class="sparkle sp-1">✦</div>
    <div class="sparkle sp-2">✧</div>
    <div class="sparkle sp-3">⋆</div>
    <div class="sparkle sp-4">✦</div>
    <div class="sparkle sp-5">✧</div>
  </div>

  <nav role="navigation" aria-label="Main navigation">
    <div class="nav-logo"><a href="/">Little Gursez</a></div>
    <ul class="nav-links">
      <li><a href="/" class={Astro.url.pathname === '/' ? 'active' : ''}>Home</a></li>
      <li><a href="/milestones" class={Astro.url.pathname.startsWith('/milestones') ? 'active' : ''}>Milestones</a></li>
      <li><a href="/stories" class={Astro.url.pathname.startsWith('/stories') ? 'active' : ''}>Stories</a></li>
    </ul>
    <button class="nav-hamburger" aria-label="Open menu" onclick="toggleMobileMenu()">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true">
    <button class="mobile-menu-close" onclick="toggleMobileMenu()" aria-label="Close menu">✕</button>
    <a href="/" onclick="toggleMobileMenu()">Home</a>
    <a href="/milestones" onclick="toggleMobileMenu()">Milestones</a>
    <a href="/stories" onclick="toggleMobileMenu()">Stories</a>
  </div>

  <slot />

  <footer>
    <div class="footer-script">Made with Love</div>
    <p class="footer-note">"Greatest adventure Sweetest surprise."</p>
    <p class="footer-tiny">© {new Date().getFullYear()} · Little Gursez's Memory Book</p>
    <p class="footer-tiny">Made with 💕 by Mum, Dad, Grandpa, Grandma & Bhua</p>
  </footer>

  <script is:inline>
    function toggleMobileMenu() {
      document.getElementById('mobileMenu').classList.toggle('open');
    }
  </script>
</body>
</html>
