---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Family Tree"
  description="Gursez's Family Tree — a tapestry of love across generations."
  image="/og/home.png"
>
  <main id="page-family" class="page active" aria-label="Family Tree">
    <div class="container">
      <div class="page-header fade-up">
        <span class="section-label">Roots &amp; Branches</span>
        <h1 class="section-title">Gursez's <em>Family Tree</em></h1>
        <p class="section-sub" style="margin:0 auto">Every person here is connected by the same thread — boundless love for our little one.</p>
      </div>

      <!-- LEGEND -->
      <div class="tree-legend fade-up">
        <div class="legend-item"><span class="legend-dot" style="background:linear-gradient(135deg,#dff8fc,#c9f4f8)"></span> Paternal Side</div>
        <div class="legend-item"><span class="legend-dot" style="background:linear-gradient(135deg,#ede4f8,#f8f0ff)"></span> Maternal Side</div>
        <div class="legend-item"><span class="legend-dot" style="background:linear-gradient(135deg,#f8e8d8,#dff8fc)"></span> Our Little Star</div>
        <div class="legend-item"><span class="legend-dot legend-line"></span> Connected by Love</div>
      </div>

      <!-- TREE CANVAS AREA -->
      <div class="tree-outer fade-up">
        <div class="tree-hint">✦ Click any card to learn more · Scroll or pinch to explore</div>
        <div class="tree-viewport" id="treeViewport">
          <div class="tree-canvas" id="treeCanvas">
            <svg id="treeSvg" style="position:absolute;top:0;left:0;pointer-events:none;overflow:visible;"></svg>
            <div id="treeNodes"></div>
          </div>
        </div>
        <!-- Pan/zoom controls -->
        <div class="tree-controls">
          <button class="tree-ctrl-btn" onclick="treeZoom(0.15)" aria-label="Zoom in">＋</button>
          <button class="tree-ctrl-btn" onclick="treeZoom(-0.15)" aria-label="Zoom out">－</button>
          <button class="tree-ctrl-btn" onclick="treeReset()" aria-label="Reset view" style="font-size:0.75rem;padding:0 12px;">Reset</button>
        </div>
      </div>

      <!-- FAMILY MEMBER DETAIL PANEL -->
      <div class="family-detail-panel" id="familyPanel" style="display:none">
        <button class="family-panel-close" onclick="closeFamilyPanel()" aria-label="Close">✕</button>
        <div id="familyPanelContent"></div>
      </div>

      <!-- FAMILY MEMBERS GRID -->
      <section class="section" aria-label="Family members">
        <div class="fade-up">
          <span class="section-label">The Whole Family</span>
          <h2 class="section-title">Everyone Who <em>Loves</em> Gursez</h2>
        </div>
        <div class="family-grid" id="familyGrid"></div>
      </section>

    </div>
  </main>

  <script is:inline>
    // Reveal Observer for .fade-up
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          revealObserver.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    
    function attachReveal(el) {
      if(!el) return;
      el.querySelectorAll('.fade-up').forEach(e => revealObserver.observe(e));
    }

    const TREE_DATA = {"treeData":[{"id":"node-bhua","data":{"name":"Satinder Kaur","relation":"Bhua Ji","side":"Paternal","emoji":"👩","color":"linear-gradient(135deg, #dff8fc, #f0fbfc)","note":"Bhua is one of Gursez's biggest fans. She was one of the first to hold him and already can't stop saying his name.","gender":"F"},"rels":{"spouses":[],"parents":["node-dada","node-dadi"],"children":[]}},{"id":"node-dad","data":{"name":"Harman Singh","relation":"Papa Ji","side":"Paternal","emoji":"👨","color":"linear-gradient(135deg, #dff8fc, #d0f5f8)","born":"December 06, 1994","note":"The one who stays up late, holds Gursez tight, and already talks about teaching him everything. His heart grew ten sizes the day Gursez arrived.","gender":"M"},"rels":{"spouses":["node-mum"],"parents":["node-dada","node-dadi"],"children":["node-gursez"]}},{"id":"node-dada","data":{"name":"Deep Singh","relation":"Dada Ji","side":"Paternal","emoji":"👴","color":"linear-gradient(135deg, #dff8fc, #c9f4f8)","note":"Dada's eyes sparkle when he holds little Gursez — a bond forged across generations and written in love.","gender":"M"},"rels":{"spouses":["node-dadi"],"parents":["node-ggf-p","node-ggm-p"],"children":["node-bhua","node-dad"]}},{"id":"node-dadi","data":{"name":"Harpreet Kaur","relation":"Dadi Ji","side":"Paternal","emoji":"👵","color":"linear-gradient(135deg, #dff8fc, #c9f4f8)","note":"Dadi whispers the oldest lullabies and fills every room with warmth when Gursez arrives.","gender":"F"},"rels":{"spouses":["node-dada"],"parents":[],"children":["node-bhua","node-dad"]}},{"id":"node-ggf-p","data":{"name":"Nand Singh","relation":"Par-Dada","side":"Paternal","emoji":"👴","color":"linear-gradient(135deg, #dff8fc, #f8f3ee)","note":"The strength that runs through our family began many generations ago. Gursez carries a proud legacy forward.","gender":"M"},"rels":{"spouses":["node-ggm-p"],"parents":["node-ggf-p2","node-ggm-p2"],"children":["node-dada"]}},{"id":"node-ggf-p2","data":{"name":"Puran Singh","relation":"Par-Par-Dada","side":"Paternal","emoji":"👴","color":"linear-gradient(135deg, #dff8fc, #f8f3ee)","note":"The roots run deep on the paternal side — blessings passed down through time.","gender":"M"},"rels":{"spouses":["node-ggm-p2"],"parents":["node-gggf-p"],"children":["node-ggf-p","node-gu-p1","node-gu-p2"]}},{"id":"node-ggm-p","data":{"name":"Ranjeet Kaur","relation":"Par-Dadi","side":"Paternal","emoji":"👵","color":"linear-gradient(135deg, #dff8fc, #f8f3ee)","note":"Her love and grace echo through each generation — a gentle warmth that finds its way to little Gursez.","gender":"F"},"rels":{"spouses":["node-ggf-p"],"parents":[],"children":["node-dada"]}},{"id":"node-ggm-p2","data":{"name":"Uttam Kaur","relation":"Par-Par-Dadi","side":"Paternal","emoji":"👵","color":"linear-gradient(135deg, #dff8fc, #f8f3ee)","note":"Her gentle spirit of perseverance is woven into the fabric of our family story.","gender":"F"},"rels":{"spouses":["node-ggf-p2"],"parents":[],"children":["node-ggf-p","node-gu-p1","node-gu-p2"]}},{"id":"node-gggf-p","data":{"name":"Maan Singh","relation":"Par-Par-Par-Dada","side":"Paternal","emoji":"👴","color":"linear-gradient(135deg, #dff8fc, #f8f3ee)","note":"The strength that runs through our family began many generations ago. Gursez carries a proud legacy forward.","gender":"M"},"rels":{"spouses":[],"parents":[],"children":["node-ggf-p2"]}},{"id":"node-ga-p1","data":{"name":"Gurdev Kaur","relation":"Par-Aunty","side":"Paternal","emoji":"👵","color":"linear-gradient(135deg, #dff8fc, #f8f3ee)","note":"Bringing warmth, wisdom, and endless love to the family.","gender":"F"},"rels":{"spouses":["node-gu-p1"],"parents":[],"children":[]}},{"id":"node-gursez","data":{"name":"Gursez","relation":"The Star of Our World","side":"Gursez","emoji":"👶","color":"linear-gradient(135deg, #f8e8d8, #dff8fc)","born":"January 13, 2026","note":"Born into a family overflowing with love. The tiny hands, the soft sighs, the first smiles — Gursez is the most wonderful chapter in all of our stories.","gender":"M"},"rels":{"spouses":[],"parents":["node-dad","node-mum"],"children":[]}},{"id":"node-gu-p1","data":{"name":"Harbans Singh","relation":"Par-Uncle","side":"Paternal","emoji":"👴","color":"linear-gradient(135deg, #dff8fc, #f8f3ee)","note":"A pillar of strength in the family, continuing the proud legacy.","gender":"M"},"rels":{"spouses":["node-ga-p1"],"parents":["node-ggf-p2","node-ggm-p2"],"children":[]}},{"id":"node-mama","data":{"name":"Amandeep & Harpreet","relation":"Maama - Maami Ji","side":"Maternal","emoji":"👨‍👩","color":"linear-gradient(135deg, #ede4f8, #f8f0ff)","note":"Mama and Mami bring so much joy and laughter. They've been showering Gursez with gifts and affection from day one.","gender":"F"},"rels":{"spouses":[],"parents":["node-nana","node-nani"],"children":[]}},{"id":"node-mum","data":{"name":"Jastinder Kaur","relation":"Mumma Ji","side":"Maternal","emoji":"👩","color":"linear-gradient(135deg, #ede4f8, #f8f0ff)","note":"Mum — the one whose heartbeat Gursez knows best. She carried him, and now she carries his whole world in her eyes.","gender":"F"},"rels":{"spouses":["node-dad"],"parents":["node-nana","node-nani"],"children":["node-gursez"]}},{"id":"node-nana","data":{"name":"Nana","relation":"Nana Ji","side":"Maternal","emoji":"👴","color":"linear-gradient(135deg, #ede4f8, #f8f0ff)","note":"Nana's smile is like sunshine. He already has big plans to take Gursez on adventures.","gender":"M"},"rels":{"spouses":["node-nani"],"parents":[],"children":["node-mama","node-mum"]}},{"id":"node-nani","data":{"name":"Nani","relation":"Nani Ji","side":"Maternal","emoji":"👵","color":"linear-gradient(135deg, #ede4f8, #f8f0ff)","note":"Nani's kitchen always smells like love, and she's already counting the days to spoil Gursez rotten.","gender":"F"},"rels":{"spouses":["node-nana"],"parents":[],"children":["node-mama","node-mum"]}},{"id":"node-gu-p2","data":{"name":"Rattan Singh","relation":"Par-Uncle","side":"Paternal","emoji":"👴","color":"linear-gradient(135deg, #dff8fc, #f8f3ee)","note":"Carrying the family's deep-rooted traditions and spirited nature.","gender":"M"},"rels":{"spouses":[],"parents":["node-ggf-p2","node-ggm-p2"],"children":[]}}]};

    /* ─── FAMILY TREE ENGINE ─────────────────────────────────── */
    function initFamilyTree() {
      const rawNodes = TREE_DATA.treeData;
      const nodeMap  = {};
      rawNodes.forEach(n => nodeMap[n.id] = n);

      /* ── 1. ASSIGN GENERATION ──────────────────────────────── */
      const genMap = {};
      function assignGen(id, g) {
        if (id in genMap) return;
        genMap[id] = g;
        const n = nodeMap[id];
        if (!n) return;
        (n.rels.spouses  || []).forEach(s  => assignGen(s,  g));
        (n.rels.parents  || []).forEach(p  => assignGen(p,  g - 1));
        (n.rels.children || []).forEach(c  => assignGen(c,  g + 1));
      }
      assignGen('node-gursez', 0);
      rawNodes.forEach(n => {
        if (!(n.id in genMap)) {
          const pg = (n.rels.parents||[]).map(p=>genMap[p]).filter(x=>x!=null);
          const sg = (n.rels.spouses||[]).map(s=>genMap[s]).filter(x=>x!=null);
          genMap[n.id] = pg.length ? pg[0]+1 : sg.length ? sg[0] : -4;
        }
      });

      /* ── 2. BUILD COUPLE-UNITS ──────────────────────────────── */
      const unitByNode = {}; 
      const units = [];
      const paired = new Set();
      rawNodes.forEach(n => {
        if (paired.has(n.id)) return;
        const spouses = (n.rels.spouses || []).filter(s => nodeMap[s]);
        if (spouses.length) {
          const sp = spouses[0];
          paired.add(n.id); paired.add(sp);
          const unit = { ids: [n.id, sp], gen: genMap[n.id], side: n.data.side };
          units.push(unit);
          unitByNode[n.id] = unit;
          unitByNode[sp]   = unit;
        }
      });
      rawNodes.forEach(n => {
        if (paired.has(n.id)) return;
        const unit = { ids: [n.id], gen: genMap[n.id], side: n.data.side };
        units.push(unit);
        unitByNode[n.id] = unit;
      });

      /* ── 3. GROUP UNITS BY GENERATION ──────────────────────── */
      const byGen = {};
      units.forEach(u => {
        if (!byGen[u.gen]) byGen[u.gen] = [];
        byGen[u.gen].push(u);
      });

      const gens = Object.keys(byGen).map(Number).sort((a,b)=>a-b);
      const sideOrder = { Paternal:0, Gursez:1, Maternal:2 };
      gens.forEach(g => {
        byGen[g].sort((a,b) => (sideOrder[a.side]??1) - (sideOrder[b.side]??1));
      });

      /* ── 4. ASSIGN PIXEL POSITIONS ──────────────────────────── */
      const CARD_W  = 128; 
      const CARD_H  = 88;  
      const COUPLE_GAP = 8;  
      const UNIT_GAP   = 36; 
      const ROW_H      = 190;
      const PAD_X      = 60;
      const PAD_Y      = 60;

      function unitWidth(u) {
        return u.ids.length === 2
          ? CARD_W * 2 + COUPLE_GAP + 20 
          : CARD_W + 20;                  
      }
      function rowTotalWidth(row) {
        return row.reduce((s,u) => s + unitWidth(u), 0) + (row.length-1) * UNIT_GAP;
      }

      const maxRowW = Math.max(...gens.map(g => rowTotalWidth(byGen[g])));
      const canvasW  = maxRowW + PAD_X * 2;
      const canvasH  = gens.length * ROW_H + PAD_Y * 2;
      const unitPos = new Map();

      gens.forEach((g, rowIdx) => {
        const row  = byGen[g];
        const rowW = rowTotalWidth(row);
        const startX = (canvasW - rowW) / 2;
        let cx = startX;
        const y = PAD_Y + rowIdx * ROW_H;
        row.forEach(u => {
          const w = unitWidth(u);
          unitPos.set(u, { x: cx, y, w, h: CARD_H + 16 }); 
          cx += w + UNIT_GAP;
        });
      });

      function unitCB(u) {
        const p = unitPos.get(u);
        return { x: p.x + p.w/2, y: p.y + p.h };
      }
      function unitCT(u) {
        const p = unitPos.get(u);
        return { x: p.x + p.w/2, y: p.y };
      }

      /* ── 5. RENDER SVG CONNECTORS ───────────────────────────── */
      const svg = document.getElementById('treeSvg');
      svg.setAttribute('width',  canvasW);
      svg.setAttribute('height', canvasH);
      svg.innerHTML = '';

      function svgEl(tag, attrs) {
        const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
        Object.entries(attrs).forEach(([k,v]) => el.setAttribute(k, v));
        svg.appendChild(el);
        return el;
      }

      function line(x1,y1,x2,y2, stroke, sw=1.8, dash='') {
        svgEl('line', { x1,y1,x2,y2, stroke, 'stroke-width':sw,
          'stroke-linecap':'round', opacity:'0.7',
          ...(dash ? {'stroke-dasharray':dash} : {}) });
      }

      units.forEach(u => {
        const childIds = [];
        u.ids.forEach(id => {
          (nodeMap[id].rels.children||[]).forEach(cid => {
            if (!childIds.includes(cid)) childIds.push(cid);
          });
        });
        if (!childIds.length) return;

        const childUnits = [...new Set(childIds.map(cid => unitByNode[cid]))];
        const pb = unitCB(u); 

        const stroke = u.side === 'Maternal' ? '#b8a8d8'
                     : u.side === 'Gursez'   ? '#c9a96e'
                     :                          '#7ac0d0';

        if (childUnits.length === 1) {
          const ct = unitCT(childUnits[0]);
          const midY = pb.y + (ct.y - pb.y) / 2;
          line(pb.x, pb.y,   pb.x, midY,   stroke);
          line(pb.x, midY,   ct.x, midY,   stroke);
          line(ct.x, midY,   ct.x, ct.y,   stroke);
        } else {
          const midY = pb.y + ROW_H * 0.38;
          line(pb.x, pb.y, pb.x, midY, stroke);
          const xs = childUnits.map(cu => unitCT(cu).x);
          const busL = Math.min(...xs, pb.x);
          const busR = Math.max(...xs, pb.x);
          line(busL, midY, busR, midY, stroke);
          childUnits.forEach(cu => {
            const ct = unitCT(cu);
            line(ct.x, midY, ct.x, ct.y, stroke);
          });
        }
      });

      /* ── 6. RENDER HTML NODES & COUPLE BOXES ────────────────── */
      const container = document.getElementById('treeNodes');
      container.innerHTML = '';

      units.forEach(u => {
        const pos = unitPos.get(u);
        const isStar   = u.ids.includes('node-gursez');
        const isCouple = u.ids.length === 2;

        const box = document.createElement('div');
        box.className = 'couple-box' +
          (isCouple ? ' couple-box--pair' : ' couple-box--solo') +
          (isStar   ? ' couple-box--star' : '') +
          (u.side === 'Paternal' ? ' couple-box--pat' : '') +
          (u.side === 'Maternal' ? ' couple-box--mat' : '');
        box.style.cssText = `left:${pos.x}px;top:${pos.y}px;width:${pos.w}px;`;

        u.ids.forEach((id, idx) => {
          const n  = nodeMap[id];
          const card = document.createElement('div');
          card.className = 'tree-node' +
            (id === 'node-gursez' ? ' node-star' : '') +
            (n.data.side === 'Paternal' ? ' node-paternal' : '') +
            (n.data.side === 'Maternal' ? ' node-maternal' : '');
          card.style.cssText = `width:${CARD_W}px;`;
          card.innerHTML = `
            <div class="node-emoji">${n.data.emoji}</div>
            <div class="node-name">${n.data.name}</div>
            <div class="node-relation">${n.data.relation}</div>`;
          card.onclick = () => openFamilyPanel(n);
          box.appendChild(card);

          if (isCouple && idx === 0) {
            const heart = document.createElement('div');
            heart.className = 'couple-heart';
            heart.textContent = '🤝';
            box.appendChild(heart);
          }
        });
        container.appendChild(box);
      });

      /* ── 7. SIZE THE CANVAS & CENTRE ON GURSEZ ──────────────── */
      const canvas = document.getElementById('treeCanvas');
      canvas.style.width  = canvasW + 'px';
      canvas.style.height = canvasH + 'px';

      const gUnit = unitByNode['node-gursez'];
      if (gUnit) {
        const gPos = unitPos.get(gUnit);
        const vp   = document.getElementById('treeViewport');
        treeState.scale = 0.82;
        treeState.x = vp.clientWidth  / 2 - (gPos.x + gPos.w/2) * treeState.scale;
        treeState.y = vp.clientHeight / 2 - (gPos.y + gPos.h/2) * treeState.scale;
        applyTreeTransform();
      }

      renderFamilyGrid(rawNodes);
      attachReveal(document.getElementById('page-family'));
    }

    /* ─── PAN & ZOOM ─────────────────────────────────────────── */
    const treeState = { x: 0, y: 0, scale: 0.85, dragging: false, startX: 0, startY: 0 };

    function applyTreeTransform() {
      const canvas = document.getElementById('treeCanvas');
      if (canvas) canvas.style.transform = `translate(${treeState.x}px,${treeState.y}px) scale(${treeState.scale})`;
    }

    function treeZoom(delta) {
      treeState.scale = Math.max(0.3, Math.min(1.8, treeState.scale + delta));
      applyTreeTransform();
    }

    function treeReset() {
      treeState.scale = 0.85;
      const star = document.querySelector('.node-star');
      if (star) {
        const vp = document.getElementById('treeViewport');
        const vpRect = vp.getBoundingClientRect();
        treeState.x = vpRect.width / 2 - (parseFloat(star.style.left) + 78) * treeState.scale;
        treeState.y = vpRect.height / 2 - (parseFloat(star.style.top) + 40) * treeState.scale;
      } else {
        treeState.x = 0; treeState.y = 0;
      }
      applyTreeTransform();
    }

    function initTreeDrag() {
      const vp = document.getElementById('treeViewport');
      if (!vp) return;
      vp.addEventListener('mousedown', e => {
        treeState.dragging = true;
        treeState.startX = e.clientX - treeState.x;
        treeState.startY = e.clientY - treeState.y;
        e.preventDefault();
      });
      window.addEventListener('mousemove', e => {
        if (!treeState.dragging) return;
        treeState.x = e.clientX - treeState.startX;
        treeState.y = e.clientY - treeState.startY;
        applyTreeTransform();
      });
      window.addEventListener('mouseup', () => { treeState.dragging = false; });

      vp.addEventListener('touchstart', e => {
        if (e.touches.length === 1) {
          treeState.dragging = true;
          treeState.startX = e.touches[0].clientX - treeState.x;
          treeState.startY = e.touches[0].clientY - treeState.y;
        }
      }, { passive: true });
      vp.addEventListener('touchmove', e => {
        if (!treeState.dragging || e.touches.length !== 1) return;
        treeState.x = e.touches[0].clientX - treeState.startX;
        treeState.y = e.touches[0].clientY - treeState.startY;
        applyTreeTransform();
      }, { passive: true });
      vp.addEventListener('touchend', () => { treeState.dragging = false; });

      vp.addEventListener('wheel', e => {
        e.preventDefault();
        treeZoom(e.deltaY < 0 ? 0.08 : -0.08);
      }, { passive: false });
    }

    /* ─── FAMILY PANEL ───────────────────────────────────────── */
    function openFamilyPanel(node) {
      const d = node.data;
      const panel = document.getElementById('familyPanel');
      const content = document.getElementById('familyPanelContent');
      const sideColors = { Paternal: '#dff8fc', Maternal: '#ede4f8', Gursez: '#f8e8d8' };
      const bgColor = sideColors[d.side] || '#f8f4f0';
      content.innerHTML = `
        <div class="fp-header">
          <div class="fp-emoji" style="background:${bgColor}">${d.emoji}</div>
          <div>
            <div class="fp-name">${d.name}</div>
            <div class="fp-relation">${d.relation}</div>
          </div>
        </div>
        <div class="fp-divider"></div>
        <div class="fp-note">"${d.note}"</div>
        ${d.born ? '<div class="fp-born">🎂 Born: ' + d.born + '</div>'  : ''}
      `;
      panel.style.display = 'block';
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function closeFamilyPanel() {
      document.getElementById('familyPanel').style.display = 'none';
    }

    /* ─── FAMILY GRID ────────────────────────────────────────── */
    function renderFamilyGrid(nodes) {
      const grid = document.getElementById('familyGrid');
      grid.innerHTML = '';
      const sorted = [...nodes].sort((a, b) => {
        const order = { Gursez: 0, Paternal: 1, Maternal: 2 };
        return (order[a.data.side] ?? 3) - (order[b.data.side] ?? 3);
      });
      sorted.forEach((n, i) => {
        const d = n.data;
        const card = document.createElement('div');
        card.className = "family-member-card side-" + d.side + " fade-up";
        card.style.transitionDelay = (i * 0.04) + "s";
        card.innerHTML = `
          <div class="fmc-emoji">${d.emoji}</div>
          <div class="fmc-name">${d.name}</div>
          <div class="fmc-relation">${d.relation}</div>
          <span class="fmc-side side-${d.side}">${d.side}</span>
        `;
        card.onclick = () => openFamilyPanel(n);
        grid.appendChild(card);
      });
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
      initTreeDrag();
      initFamilyTree();
    });
  </script>
</Layout>

<style is:global>
/* LEGEND */
.tree-legend {
  display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;
  margin-bottom: 32px;
}
.legend-item {
  display: flex; align-items: center; gap: 8px;
  font-size: 0.78rem; color: var(--text-soft); letter-spacing: 0.04em;
}
.legend-dot {
  width: 20px; height: 20px; border-radius: 50%;
  border: 1.5px solid rgba(100,70,60,0.12); flex-shrink: 0;
}
.legend-line {
  background: none !important;
  position: relative; border-radius: 0; width: 28px; height: 2px;
  background: linear-gradient(90deg, var(--blush), var(--lavender)) !important;
  border: none; border-radius: 99px;
}

/* TREE VIEWPORT */
.tree-outer {
  background: var(--warm-white); border-radius: var(--radius-lg);
  border: 1px solid rgba(200,160,140,0.12); box-shadow: var(--shadow-soft);
  overflow: hidden; position: relative; margin-bottom: 60px;
