---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const family = await getCollection('family');

// Build a lookup map keyed by nodeId for the inline script
const membersMap = Object.fromEntries(
  family.map(m => [m.data.nodeId, m.data])
);
const membersJSON = JSON.stringify(membersMap);

// Helpers: pull specific members for typed access
const dad    = family.find(m => m.data.nodeId === 'node-dad')?.data;
const mum    = family.find(m => m.data.nodeId === 'node-mum')?.data;
const gursez = family.find(m => m.data.nodeId === 'node-gursez')?.data;
---

<Layout
  title="Family Tree"
  description="The beautiful family tree of Gursez Singh Hira — a tapestry of love across generations."
  image="/og/home.png"
>
  <main id="page-family-tree" class="page active" aria-label="Family Tree">
    <div class="container">

      <div class="page-header fade-up">
        <span class="section-label">Rooted in Love</span>
        <h1 class="section-title">Gursez's <em>Family Tree</em></h1>
        <p class="section-sub" style="margin:0 auto">Every branch a story, every leaf a heartbeat. This is where Gursez belongs.</p>
      </div>

      <!-- ── MOBILE VIEW (≤768px) ──────────────────────────── -->
      <div class="ft-mobile-view fade-up" style="transition-delay:0.1s">

        <div class="ft-desktop-hint">
          <div class="ft-desktop-hint-icon">🌳</div>
          <p>
            The full family tree is best explored on a larger screen.<br>
            <strong>Visit on desktop</strong> to see all generations and every branch of the tree.
          </p>
        </div>

        <div class="ft-mobile-parents">

          <!-- Dad & Mum couple row -->
          <div class="ft-mobile-couple">
            {dad && (
              <div
                class="ft-mobile-member"
                id={`mobile-${dad.nodeId}`}
                tabindex="0" role="button"
                aria-label={dad.name}
              >
                <div class="ft-avatar ft-avatar--lg">{dad.emoji}</div>
                <div class="ft-name">{dad.name}</div>
                <div class="ft-relation">{dad.relation}</div>
              </div>
            )}
            <div class="ft-mobile-heart">💑</div>
            {mum && (
              <div
                class="ft-mobile-member"
                id={`mobile-${mum.nodeId}`}
                tabindex="0" role="button"
                aria-label={mum.name}
              >
                <div class="ft-avatar ft-avatar--lg">{mum.emoji}</div>
                <div class="ft-name">{mum.name}</div>
                <div class="ft-relation">{mum.relation}</div>
              </div>
            )}
          </div>

          <!-- Connector line -->
          <div class="ft-mobile-connector" aria-hidden="true"></div>

          <!-- Gursez -->
          {gursez && (
            <div
              class="ft-mobile-member ft-mobile-gursez"
              id={`mobile-${gursez.nodeId}`}
              tabindex="0" role="button"
              aria-label={gursez.name}
            >
              <div class="ft-avatar ft-avatar--hero">{gursez.emoji}</div>
              <div class="ft-name ft-name--hero">{gursez.name}</div>
              <div class="ft-relation ft-relation--hero">Singh Hira</div>
              {gursez.born && <div class="ft-born">Born · {gursez.born}</div>}
            </div>
          )}

        </div>
      </div><!-- /ft-mobile-view -->

      <!-- ── LEGEND (desktop only) ─────────────────────────── -->
      <div class="ft-legend fade-up" style="transition-delay:0.1s" aria-label="Legend">
        <div class="ft-legend-item"><span class="ft-dot ft-dot--paternal"></span> Paternal Side</div>
        <div class="ft-legend-item"><span class="ft-dot ft-dot--maternal"></span> Maternal Side</div>
        <div class="ft-legend-item"><span class="ft-dot ft-dot--gursez"></span> Gursez</div>
        <div class="ft-legend-item"><span class="ft-dot ft-dot--parents"></span> Parents</div>
      </div>

      <!-- ── TREE CANVAS (desktop only) ─────────────────────── -->
      <div class="ft-canvas fade-up" style="transition-delay:0.2s" role="img" aria-label="Family tree diagram">

        <!-- ── GENERATION 1: GREAT-GRANDPARENTS ──────────────── -->
        <div class="ft-gen ft-gen--1">
          <div class="ft-node ft-node--paternal" id="node-ggf-p" tabindex="0" role="button" aria-label="Paternal Great-Grandfather">
            <div class="ft-avatar">👴</div>
            <div class="ft-name">Great-Grandpa</div>
            <div class="ft-relation">Dada's Father</div>
          </div>
          <div class="ft-node ft-node--paternal" id="node-ggm-p" tabindex="0" role="button" aria-label="Paternal Great-Grandmother">
            <div class="ft-avatar">👵</div>
            <div class="ft-name">Great-Grandma</div>
            <div class="ft-relation">Dada's Mother</div>
          </div>
          <div class="ft-spacer"></div>
          <div class="ft-node ft-node--paternal" id="node-ggf-p2" tabindex="0" role="button" aria-label="Paternal Great-Grandfather 2">
            <div class="ft-avatar">👴</div>
            <div class="ft-name">Great-Grandpa</div>
            <div class="ft-relation">Dadi's Father</div>
          </div>
          <div class="ft-node ft-node--paternal" id="node-ggm-p2" tabindex="0" role="button" aria-label="Paternal Great-Grandmother 2">
            <div class="ft-avatar">👵</div>
            <div class="ft-name">Great-Grandma</div>
            <div class="ft-relation">Dadi's Mother</div>
          </div>
        </div>

        <!-- ── GENERATION 2: GRANDPARENTS ─────────────────────── -->
        <div class="ft-gen ft-gen--2">
          <div class="ft-couple ft-couple--paternal">
            <div class="ft-node ft-node--paternal" id="node-dada" tabindex="0" role="button" aria-label="Dada">
              <div class="ft-avatar ft-avatar--lg">👴</div>
              <div class="ft-name">Dada</div>
              <div class="ft-relation">Paternal Grandfather</div>
            </div>
            <div class="ft-connector-heart" aria-hidden="true">🤝</div>
            <div class="ft-node ft-node--paternal" id="node-dadi" tabindex="0" role="button" aria-label="Dadi">
              <div class="ft-avatar ft-avatar--lg">👵</div>
              <div class="ft-name">Dadi</div>
              <div class="ft-relation">Paternal Grandmother</div>
            </div>
          </div>

          <div class="ft-couple ft-couple--maternal">
            <div class="ft-node ft-node--maternal" id="node-nana" tabindex="0" role="button" aria-label="Nana">
              <div class="ft-avatar ft-avatar--lg">👴</div>
              <div class="ft-name">Nana</div>
              <div class="ft-relation">Maternal Grandfather</div>
            </div>
            <div class="ft-connector-heart" aria-hidden="true">🤝</div>
            <div class="ft-node ft-node--maternal" id="node-nani" tabindex="0" role="button" aria-label="Nani">
              <div class="ft-avatar ft-avatar--lg">👵</div>
              <div class="ft-name">Nani</div>
              <div class="ft-relation">Maternal Grandmother</div>
            </div>
          </div>
        </div>

        <!-- ── GENERATION 3: PARENTS + SIBLINGS ───────────────── -->
        <div class="ft-gen ft-gen--3">
          <div class="ft-node ft-node--paternal ft-node--sibling" id="node-bhua" tabindex="0" role="button" aria-label="Bhua">
            <div class="ft-avatar">👩</div>
            <div class="ft-name">Bhua</div>
            <div class="ft-relation">Paternal Aunt</div>
          </div>

          <div class="ft-couple ft-couple--parents">
            <div class="ft-node ft-node--paternal ft-node--parent" id="node-dad" tabindex="0" role="button" aria-label="Dad">
              <div class="ft-avatar ft-avatar--xl">👨</div>
              <div class="ft-name">Dad</div>
              <div class="ft-relation">Father</div>
            </div>
            <div class="ft-connector-heart ft-connector-heart--parents" aria-hidden="true">💑</div>
            <div class="ft-node ft-node--maternal ft-node--parent" id="node-mum" tabindex="0" role="button" aria-label="Mum">
              <div class="ft-avatar ft-avatar--xl">👩</div>
              <div class="ft-name">Mum</div>
              <div class="ft-relation">Mother</div>
            </div>
          </div>

          <div class="ft-node ft-node--maternal ft-node--sibling" id="node-mama" tabindex="0" role="button" aria-label="Mama-Mami">
            <div class="ft-avatar">👨‍👩</div>
            <div class="ft-name">Mama &amp; Mami</div>
            <div class="ft-relation">Maternal Uncle &amp; Aunt</div>
          </div>
        </div>

        <!-- ── GENERATION 4: GURSEZ ───────────────────────────── -->
        <div class="ft-gen ft-gen--4">
          <div class="ft-node ft-node--gursez ft-node--star" id="node-gursez" tabindex="0" role="button" aria-label="Gursez Singh Hira">
            <div class="ft-avatar ft-avatar--hero">👶</div>
            <div class="ft-name ft-name--hero">Gursez</div>
            <div class="ft-relation ft-relation--hero">Singh Hira</div>
            <div class="ft-star-ring" aria-hidden="true"></div>
            <div class="ft-born">Born · January 13, 2026</div>
          </div>
        </div>

      </div><!-- /ft-canvas -->

    </div><!-- /container -->

    <!-- MEMBER DETAIL PANEL (shared desktop + mobile) -->
    <div class="ft-panel" id="ftPanel" role="dialog" aria-modal="true" aria-label="Family member details">
      <div class="ft-panel-inner" id="ftPanelContent"></div>
      <button class="ft-panel-close" id="ftPanelClose" aria-label="Close panel">✕</button>
    </div>
    <div class="ft-panel-overlay" id="ftOverlay"></div>

  </main>

  <script is:inline define:vars={{ membersJSON }}>
    var MEMBERS = JSON.parse(membersJSON);

    var panel    = document.getElementById('ftPanel');
    var overlay  = document.getElementById('ftOverlay');
    var content  = document.getElementById('ftPanelContent');
    var closeBtn = document.getElementById('ftPanelClose');

    function openPanel(id) {
      // strip mobile- prefix if coming from mobile cards
      var key = id.replace(/^mobile-/, '');
      if (!Object.prototype.hasOwnProperty.call(MEMBERS, key)) return;
      var m = MEMBERS[key];
      if (!content || !panel || !overlay || !closeBtn) return;
      content.innerHTML =
        '<div class="fp-avatar-wrap" style="background:' + m.color + '">' + m.emoji + '</div>' +
        '<span class="fp-relation">' + m.side + ' Family</span>' +
        '<h2 class="fp-name">' + m.name + '</h2>' +
        '<div class="fp-divider"></div>' +
        '<div class="fp-fact"><span class="fp-fact-icon">🌿</span><div>' +
          '<span class="fp-fact-label">Role in the Tree</span>' +
          '<span class="fp-fact-val">' + m.relation + '</span>' +
        '</div></div>' +
        (m.born
          ? '<div class="fp-fact"><span class="fp-fact-icon">🎂</span><div>' +
            '<span class="fp-fact-label">Born</span>' +
            '<span class="fp-fact-val">' + m.born + '</span>' +
            '</div></div>'
          : '') +
        '<div class="fp-love-note">"' + m.note + '"</div>';
      panel.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closePanel() {
      if (!panel || !overlay) return;
      panel.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    if (closeBtn) closeBtn.addEventListener('click', closePanel);
    if (overlay)  overlay.addEventListener('click', closePanel);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closePanel(); });

    // Desktop nodes + mobile cards both use the same openPanel handler
    document.querySelectorAll('.ft-node[id], .ft-mobile-member[id]').forEach(function(node) {
      node.addEventListener('click', function() { openPanel(node.id); });
      node.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPanel(node.id); }
      });
    });

    // Fade-up observer
    var revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-up').forEach(function(el) { revealObserver.observe(el); });
  </script>

</Layout>