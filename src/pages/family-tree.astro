---
import Layout from '../layouts/Layout.astro';
import MemberModal from '../components/MemberModal.astro';
import { getCollection } from 'astro:content';

const family = await getCollection('family');

// ── Panel data: full map passed to client script ───────────────
const membersMap = Object.fromEntries(family.map(m => [m.data.nodeId, m.data]));
const membersJSON = JSON.stringify(membersMap);

// ── Types ──────────────────────────────────────────────────────
type Member = (typeof family)[number]['data'];

// ── Helpers ────────────────────────────────────────────────────
const get = (id: string) => family.find(m => m.data.nodeId === id)?.data;

// CSS side modifier (case-insensitive)
const sideClass = (side: string = '') =>
  side.toLowerCase() === 'maternal' ? 'ft-node--maternal' : 'ft-node--paternal';

// ── Couple-grouping logic ──────────────────────────────────────
// Group members that share a coupleId into pairs.
// Members without a coupleId are treated as singletons.
// Within each generation we produce an ordered list of "slots":
//   { type: 'couple', coupleId, members: [m1, m2?], side }
//   { type: 'single', member }

type CoupleSlot = { type: 'couple'; coupleId: string; members: Member[]; side: string };
type SingleSlot = { type: 'single'; member: Member };
type Slot = CoupleSlot | SingleSlot;

function buildSlots(members: Member[]): Slot[] {
  const slots: Slot[] = [];
  const seen = new Set<string>();

  for (const m of members) {
    if (m.coupleId) {
      if (seen.has(m.coupleId)) continue; // already added as part of the pair
      seen.add(m.coupleId);
      const pair = members.filter(x => x.coupleId === m.coupleId);
      slots.push({ type: 'couple', coupleId: m.coupleId, members: pair, side: m.side });
    } else {
      slots.push({ type: 'single', member: m });
    }
  }
  return slots;
}

// ── Generation grouping ────────────────────────────────────────
// Collect all unique generation numbers and sort ascending (oldest first).
const allGenerations = [...new Set(family.map(m => m.data.generation))].sort((a, b) => a - b);

// For each generation, split into paternal and maternal columns.
// Structured nodeIds handled separately (gen 3 & 4) are excluded here.
const structuredIds = new Set([
  'node-bhua','node-dad','node-mum','node-mama','node-gursez',
  'node-dada','node-dadi','node-nana','node-nani',
]);

function getMembersForGen(gen: number): { paternal: Member[]; maternal: Member[] } {
  const all = family
    .map(m => m.data)
    .filter(m => m.generation === gen && !structuredIds.has(m.nodeId));
  return {
    paternal: all.filter(m => m.side.toLowerCase() === 'paternal'),
    maternal: all.filter(m => m.side.toLowerCase() === 'maternal'),
  };
}

// Dynamic generations = everything except gen 3 (parents row) and gen 4 (Gursez)
const dynamicGens = allGenerations.filter(g => g <= 2);

// ── Named lookups for structured rows ─────────────────────────
const dad    = get('node-dad');
const mum    = get('node-mum');
const gursez = get('node-gursez');
const bhua   = get('node-bhua');
const mama   = get('node-mama');
const dada   = get('node-dada');
const dadi   = get('node-dadi');
const nana   = get('node-nana');
const nani   = get('node-nani');
---

<Layout
  title="Family Tree"
  description="The beautiful family tree of Gursez Singh Hira — a tapestry of love across generations."
  image="/og/home.png"
>
  <main id="page-family-tree" class="page active" aria-label="Family Tree">
    <div class="container">

      <div class="page-header fade-up">
        <span class="section-label">Rooted in Love</span>
        <h1 class="section-title">Gursez's <em>Family Tree</em></h1>
        <p class="section-sub" style="margin:0 auto">Every branch a story, every leaf a heartbeat. This is where Gursez belongs.</p>
      </div>

      <!-- ── MOBILE VIEW (≤768px) ──────────────────────────── -->
      <div class="ft-mobile-view fade-up" style="transition-delay:0.1s">
        <div class="ft-desktop-hint">
          <div class="ft-desktop-hint-icon">🌳</div>
          <p>
            The full family tree is best explored on a larger screen.<br>
            <strong>Visit on desktop</strong> to see all generations and every branch of the tree.
          </p>
        </div>
        <div class="ft-mobile-parents">
          <div class="ft-mobile-couple">
            {dad && (
              <div class="ft-mobile-member" id={`mobile-${dad.nodeId}`} tabindex="0" role="button" aria-label={dad.name}>
                <div class="ft-avatar ft-avatar--lg">{dad.emoji}</div>
                <div class="ft-name">{dad.name}</div>
                <div class="ft-relation">{dad.relation}</div>
              </div>
            )}
            <div class="ft-mobile-heart">💑</div>
            {mum && (
              <div class="ft-mobile-member" id={`mobile-${mum.nodeId}`} tabindex="0" role="button" aria-label={mum.name}>
                <div class="ft-avatar ft-avatar--lg">{mum.emoji}</div>
                <div class="ft-name">{mum.name}</div>
                <div class="ft-relation">{mum.relation}</div>
              </div>
            )}
          </div>
          <div class="ft-mobile-connector" aria-hidden="true"></div>
          {gursez && (
            <div class="ft-mobile-member ft-mobile-gursez" id={`mobile-${gursez.nodeId}`} tabindex="0" role="button" aria-label={gursez.name}>
              <div class="ft-avatar ft-avatar--hero">{gursez.emoji}</div>
              <div class="ft-name ft-name--hero">{gursez.name}</div>
              <div class="ft-relation ft-relation--hero">Singh Hira</div>
              {gursez.born && <div class="ft-born">Born · {gursez.born}</div>}
            </div>
          )}
        </div>
      </div>

      <!-- ── LEGEND ─────────────────────────────────────────── -->
      <div class="ft-legend fade-up" style="transition-delay:0.1s" aria-label="Legend">
        <div class="ft-legend-item"><span class="ft-dot ft-dot--paternal"></span> Paternal Side</div>
        <div class="ft-legend-item"><span class="ft-dot ft-dot--maternal"></span> Maternal Side</div>
        <div class="ft-legend-item"><span class="ft-dot ft-dot--gursez"></span> Gursez</div>
        <div class="ft-legend-item"><span class="ft-dot ft-dot--parents"></span> Parents</div>
      </div>

      <!-- ── TREE CANVAS ────────────────────────────────────── -->
      <div class="ft-canvas-wrapper" style="width: 100vw; margin-left: calc(-50vw + 50%); overflow-x: auto; padding: 0 1rem;">
        <div class="ft-canvas fade-up" style="transition-delay:0.2s; min-width: max-content; width: fit-content; margin: 0 auto; position: relative;" role="img" aria-label="Family tree diagram">

        <!--
          ── HOW GENERATIONS ARE ORDERED ────────────────────────
          Generation numbers in the JSON files control vertical order.
          Lower number = older ancestor = higher up the tree.

          Recommended numbering:
            0  = great-great-grandparents  (e.g. Maan Singh)
            1  = great-grandparents        (e.g. Puran Singh & Uttam Kaur)
            2  = grandparents              (Dada/Dadi, Nana/Nani)
            3  = parents + aunts/uncles    (structured row, see below)
            4  = Gursez                    (structured row, see below)

          ── HOW COUPLES WORK ───────────────────────────────────
          Give two people the same "coupleId" string in their JSON.
          They render as a connected pair automatically.

          ── HOW SIBLINGS / CHILD LINES WORK ───────────────────
          Give a person "parentCoupleId": "<coupleId of their parents>"
          and a CSS child-line will be drawn from the couple box down
          to that person's node.  Works even if not all siblings are
          added yet — each child just references the same parentCoupleId.
        -->

        <!-- Dynamic generations (≤ 2): oldest ancestors at the top -->
        {dynamicGens.map(gen => {
          const { paternal, maternal } = getMembersForGen(gen);
          if (!paternal.length && !maternal.length) return null;

          const paternalSlots = buildSlots(paternal);
          const maternalSlots = buildSlots(maternal);

          return (
            <div class={`ft-gen ft-gen--dyn`} data-gen={gen}>

              {/* ── PATERNAL COLUMN (left) ── */}
              <div class="ft-gen-col ft-gen-col--paternal">
                {paternalSlots.map(slot => slot.type === 'couple' ? (
                  <div
                    class={`ft-couple ft-couple--paternal`}
                    id={`couple-${slot.coupleId}`}
                    data-couple-id={slot.coupleId}
                    data-side="paternal"
                  >
                    {slot.members.map((m, i) => (
                      <>
                        {i > 0 && <div class="ft-connector-heart" aria-hidden="true">🤝</div>}
                        <div
                          class={`ft-node ${sideClass(m.side)}`}
                          id={m.nodeId}
                          data-parent-couple-id={m.parentCoupleId}
                          tabindex="0" role="button"
                          aria-label={m.name}
                        >
                          <div class="ft-avatar">{m.emoji}</div>
                          <div class="ft-name">{m.name}</div>
                          <div class="ft-relation">{m.relation}</div>
                          {m.born && <div class="ft-born">{m.born}</div>}
                        </div>
                      </>
                    ))}
                  </div>
                ) : (
                  <div
                    class={`ft-node ${sideClass(slot.member.side)}`}
                    id={slot.member.nodeId}
                    data-parent-couple-id={slot.member.parentCoupleId}
                    tabindex="0" role="button"
                    aria-label={slot.member.name}
                  >
                    <div class="ft-avatar">{slot.member.emoji}</div>
                    <div class="ft-name">{slot.member.name}</div>
                    <div class="ft-relation">{slot.member.relation}</div>
                    {slot.member.born && <div class="ft-born">{slot.member.born}</div>}
                  </div>
                ))}
              </div>

              {/* ── SPACER ── */}
              <div class="ft-spacer"></div>

              {/* ── MATERNAL COLUMN (right) ── */}
              <div class="ft-gen-col ft-gen-col--maternal">
                {maternalSlots.map(slot => slot.type === 'couple' ? (
                  <div
                    class={`ft-couple ft-couple--maternal`}
                    id={`couple-${slot.coupleId}`}
                    data-couple-id={slot.coupleId}
                    data-side="maternal"
                  >
                    {slot.members.map((m, i) => (
                      <>
                        {i > 0 && <div class="ft-connector-heart" aria-hidden="true">🤝</div>}
                        <div
                          class={`ft-node ${sideClass(m.side)}`}
                          id={m.nodeId}
                          data-parent-couple-id={m.parentCoupleId}
                          tabindex="0" role="button"
                          aria-label={m.name}
                        >
                          <div class="ft-avatar">{m.emoji}</div>
                          <div class="ft-name">{m.name}</div>
                          <div class="ft-relation">{m.relation}</div>
                          {m.born && <div class="ft-born">{m.born}</div>}
                        </div>
                      </>
                    ))}
                  </div>
                ) : (
                  <div
                    class={`ft-node ${sideClass(slot.member.side)}`}
                    id={slot.member.nodeId}
                    data-parent-couple-id={slot.member.parentCoupleId}
                    tabindex="0" role="button"
                    aria-label={slot.member.name}
                  >
                    <div class="ft-avatar">{slot.member.emoji}</div>
                    <div class="ft-name">{slot.member.name}</div>
                    <div class="ft-relation">{slot.member.relation}</div>
                    {slot.member.born && <div class="ft-born">{slot.member.born}</div>}
                  </div>
                ))}
              </div>

            </div>
          );
        })}

        <!-- ── GENERATION 2: GRANDPARENTS (structured couples) ── -->
        <div class="ft-gen ft-gen--2">
          {(dada || dadi) && (
            <div class="ft-couple ft-couple--paternal" id="couple-dada-dadi" data-couple-id="couple-dada-dadi" data-side="paternal">
              {dada && (
                <div class={`ft-node ${sideClass(dada.side)}`} id={dada.nodeId} data-parent-couple-id={dada.parentCoupleId} tabindex="0" role="button" aria-label={dada.name}>
                  <div class="ft-avatar ft-avatar--lg">{dada.emoji}</div>
                  <div class="ft-name">{dada.name}</div>
                  <div class="ft-relation">{dada.relation}</div>
                </div>
              )}
              <div class="ft-connector-heart" aria-hidden="true">🤝</div>
              {dadi && (
                <div class={`ft-node ${sideClass(dadi.side)}`} id={dadi.nodeId} data-parent-couple-id={dadi.parentCoupleId} tabindex="0" role="button" aria-label={dadi.name}>
                  <div class="ft-avatar ft-avatar--lg">{dadi.emoji}</div>
                  <div class="ft-name">{dadi.name}</div>
                  <div class="ft-relation">{dadi.relation}</div>
                </div>
              )}
            </div>
          )}
          {(nana || nani) && (
            <div class="ft-couple ft-couple--maternal" id="couple-nana-nani" data-couple-id="couple-nana-nani" data-side="maternal">
              {nana && (
                <div class={`ft-node ${sideClass(nana.side)}`} id={nana.nodeId} data-parent-couple-id={nana.parentCoupleId} tabindex="0" role="button" aria-label={nana.name}>
                  <div class="ft-avatar ft-avatar--lg">{nana.emoji}</div>
                  <div class="ft-name">{nana.name}</div>
                  <div class="ft-relation">{nana.relation}</div>
                </div>
              )}
              <div class="ft-connector-heart" aria-hidden="true">🤝</div>
              {nani && (
                <div class={`ft-node ${sideClass(nani.side)}`} id={nani.nodeId} data-parent-couple-id={nani.parentCoupleId} tabindex="0" role="button" aria-label={nani.name}>
                  <div class="ft-avatar ft-avatar--lg">{nani.emoji}</div>
                  <div class="ft-name">{nani.name}</div>
                  <div class="ft-relation">{nani.relation}</div>
                </div>
              )}
            </div>
          )}
        </div>

        <!-- ── GENERATION 3: PARENTS + SIBLINGS ───────────────── -->
        <div class="ft-gen ft-gen--3">
          {bhua && (
            <div class={`ft-node ${sideClass(bhua.side)} ft-node--sibling`} id={bhua.nodeId} data-parent-couple-id={bhua.parentCoupleId} tabindex="0" role="button" aria-label={bhua.name}>
              <div class="ft-avatar">{bhua.emoji}</div>
              <div class="ft-name">{bhua.name}</div>
              <div class="ft-relation">{bhua.relation}</div>
            </div>
          )}
          {(dad || mum) && (
            <div class="ft-couple ft-couple--parents" id="couple-dad-mum" data-couple-id="couple-dad-mum" data-side="parents">
              {dad && (
                <div class={`ft-node ${sideClass(dad.side)} ft-node--parent`} id={dad.nodeId} data-parent-couple-id={dad.parentCoupleId} tabindex="0" role="button" aria-label={dad.name}>
                  <div class="ft-avatar ft-avatar--xl">{dad.emoji}</div>
                  <div class="ft-name">{dad.name}</div>
                  <div class="ft-relation">{dad.relation}</div>
                </div>
              )}
              <div class="ft-connector-heart ft-connector-heart--parents" aria-hidden="true">💑</div>
              {mum && (
                <div class={`ft-node ${sideClass(mum.side)} ft-node--parent`} id={mum.nodeId} data-parent-couple-id={mum.parentCoupleId} tabindex="0" role="button" aria-label={mum.name}>
                  <div class="ft-avatar ft-avatar--xl">{mum.emoji}</div>
                  <div class="ft-name">{mum.name}</div>
                  <div class="ft-relation">{mum.relation}</div>
                </div>
              )}
            </div>
          )}
          {mama && (
            <div class={`ft-node ${sideClass(mama.side)} ft-node--sibling`} id={mama.nodeId} data-parent-couple-id={mama.parentCoupleId} tabindex="0" role="button" aria-label={mama.name}>
              <div class="ft-avatar">{mama.emoji}</div>
              <div class="ft-name">{mama.name}</div>
              <div class="ft-relation">{mama.relation}</div>
            </div>
          )}
        </div>

        <!-- ── GENERATION 4: GURSEZ ───────────────────────────── -->
        <div class="ft-gen ft-gen--4">
          {gursez && (
            <div class="ft-node ft-node--gursez ft-node--star" id={gursez.nodeId} data-parent-couple-id={gursez.parentCoupleId} tabindex="0" role="button" aria-label={gursez.name}>
              <div class="ft-avatar ft-avatar--hero">{gursez.emoji}</div>
              <div class="ft-name ft-name--hero">{gursez.name}</div>
              <div class="ft-relation ft-relation--hero">Singh Hira</div>
              <div class="ft-star-ring" aria-hidden="true"></div>
              {gursez.born && <div class="ft-born">Born · {gursez.born}</div>}
            </div>
          )}
        </div>

      </div><!-- /ft-canvas-wrapper -->
    </div><!-- /container -->

    <!-- ── MEMBER DETAIL PANEL (slide-in variant) ─────────────── -->
    <MemberModal id="ftPanel" label="Family member details" variant="panel" />

  </main>

  <script is:inline define:vars={{ membersJSON }}>
    var MEMBERS = JSON.parse(membersJSON);

    function buildMemberHTML(m) {
      return (
        '<div class="fp-avatar-wrap" style="background:' + m.color + '">' + m.emoji + '</div>' +
        '<span class="fp-relation">' + m.side + ' Family</span>' +
        '<h2 class="fp-name">' + m.name + '</h2>' +
        '<div class="fp-divider"></div>' +
        '<div class="fp-fact"><span class="fp-fact-icon">🌿</span><div>' +
          '<span class="fp-fact-label">Role in the Tree</span>' +
          '<span class="fp-fact-val">' + m.relation + '</span>' +
        '</div></div>' +
        (m.born
          ? '<div class="fp-fact"><span class="fp-fact-icon">🎂</span><div>' +
            '<span class="fp-fact-label">Born</span>' +
            '<span class="fp-fact-val">' + m.born + '</span>' +
            '</div></div>'
          : '') +
        '<div class="fp-love-note">"' + m.note + '"</div>'
      );
    }

    function openMemberPanel(id) {
      var key = id.replace(/^mobile-/, '');
      if (!Object.prototype.hasOwnProperty.call(MEMBERS, key)) return;
      if (typeof window['ftPanel_open'] === 'function') {
        window['ftPanel_open'](buildMemberHTML(MEMBERS[key]));
      }
    }

    document.querySelectorAll('.ft-node[id], .ft-mobile-member[id]').forEach(function(node) {
      node.addEventListener('click', function() { openMemberPanel(node.id); });
      node.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openMemberPanel(node.id); }
      });
    });

    // ── Draw child lines from couple boxes to child nodes ──────
    // Stroke colours match each side's CSS theme:
    //   paternal → cyan  (#5cd7ea)
    //   maternal → purple (#9a7ec8)
    //   parents  → sage  (#16cbdc)
    var SIDE_STROKE = {
      paternal: 'rgba(92,215,234,0.55)',
      maternal: 'rgba(154,126,200,0.55)',
      parents:  'rgba(22,203,220,0.65)',
    };

    function drawChildLines() {
      var canvas = document.querySelector('.ft-canvas');
      if (!canvas) return;

      canvas.querySelectorAll('.ft-child-line').forEach(function(el) { el.remove(); });

      var canvasRect = canvas.getBoundingClientRect();

      document.querySelectorAll('[data-parent-couple-id]').forEach(function(childEl) {
        var parentCoupleId = childEl.getAttribute('data-parent-couple-id');
        var parentEl = document.querySelector('[data-couple-id="' + parentCoupleId + '"]');
        if (!parentEl) return;

        // Pick stroke colour from the parent couple's data-side attribute
        var side   = parentEl.getAttribute('data-side') || 'paternal';
        var stroke = SIDE_STROKE[side] || SIDE_STROKE.paternal;

        var pRect = parentEl.getBoundingClientRect();
        var cRect = childEl.getBoundingClientRect();

        var x1 = pRect.left + pRect.width / 2 - canvasRect.left;
        var y1 = pRect.bottom - canvasRect.top;
        var x2 = cRect.left + cRect.width / 2 - canvasRect.left;
        var y2 = cRect.top - canvasRect.top;

        var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.classList.add('ft-child-line');
        svg.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:visible;';

        var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        var midY = (y1 + y2) / 2;
        path.setAttribute('d', 'M ' + x1 + ' ' + y1 + ' C ' + x1 + ' ' + midY + ', ' + x2 + ' ' + midY + ', ' + x2 + ' ' + y2);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', stroke);
        path.setAttribute('stroke-width', '1.5');
        path.setAttribute('stroke-dasharray', '4 3');

        svg.appendChild(path);
        canvas.appendChild(svg);
      });
    }

    window.addEventListener('load', drawChildLines);
    window.addEventListener('resize', drawChildLines);

    // Fade-up observer
    var revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
          if (entry.target.classList.contains('ft-canvas')) drawChildLines();
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-up').forEach(function(el) { revealObserver.observe(el); });
  </script>

</Layout>

<style>
  /* ── Dynamic generation row layout ───────────────────────── */
  .ft-gen--dyn {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  /* Left / right column inside a dynamic gen row */
  .ft-gen-col {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex: 1;
  }

  /* Spacer between paternal and maternal columns */
  .ft-gen--dyn .ft-spacer {
    flex: 0 0 48px;
  }
  .container { max-width: 100vw!important; width: 100vw!important; }
</style>