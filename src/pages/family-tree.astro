---
/**
 * family-tree.astro
 *
 * Systematic modernization:
 * - Monolithic template split into modular components.
 * - Client-side scripts migrated to TypeScript.
 * - View Transitions ready (Page Load orchestrator).
 */

import Layout from '../layouts/Layout.astro';
import { TREE_DATA } from '../data/family-tree';

// Modular Components
import TreeLegend from '../components/TreeLegend.astro';
import TreeFilters from '../components/TreeFilters.astro';
import TreeControls from '../components/TreeControls.astro';
import FamilyGrid from '../components/FamilyGrid.astro';
import MobileSummary from '../components/MobileSummary.astro';

/**
 * Generate per-branch CSS custom overrides at build time.
 * Each branch in TREE_DATA carries its own theme colours.
 */
const branchCSS = TREE_DATA.branches.map(b => `
  .ft-dot--${b.id}                            { background: ${b.theme.dot} !important; }
  .ft-couple-box--${b.id}                     { background: ${b.theme.boxBg} !important; border-color: ${b.theme.boxBorder} !important; }
  .ft-node--${b.id}                           { border-top: 3px solid ${b.theme.nodeBorder} !important; background: ${b.theme.nodeBg} !important; }
  .family-member-card.side-${b.id}::before    { background: ${b.theme.gridBefore} !important; }
  .fmc-side.side-${b.id}                      { background: ${b.theme.gridBadgeBg} !important; color: ${b.theme.gridBadgeText} !important; }
`).join('\n');
---

<Layout
  title="Family Tree"
  description="Gursez's Family Tree — a tapestry of love across generations."
  image="/og/home.png"
>
  <main id="page-family-tree" class="page active" aria-label="Family Tree">

    <!-- Branch-specific colour overrides (injected at build time) -->
    <style is:global set:html={branchCSS} />

    <div class="container">

      <!-- PAGE HEADER -->
      <header class="page-header fade-up">
        <span class="section-label">Rooted in Love</span>
        <h1 class="section-title">Gursez's <em>Family Tree</em></h1>
        <p class="section-sub" style="margin:0 auto">
          Every branch a story, every leaf a heartbeat. This is where Gursez belongs.
        </p>
      </header>

      <!-- LEGEND Component -->
      <TreeLegend branches={TREE_DATA.branches} />

      <!-- BRANCH FILTERS Component -->
      <TreeFilters />

      <!-- INTERACTIVE TREE (Desktop/Tablet) -->
      <div class="tree-outer fade-up">
        <div class="tree-hint">✦ Click any card to learn more · Scroll or pinch to explore</div>

        <div class="tree-viewport" id="treeViewport">
          <div class="tree-canvas" id="treeCanvas">
            <!-- SVG bezier connectors -->
            <svg
              id="treeSvg"
              style="position:absolute; top:0; left:0; pointer-events:none; overflow:visible;"
            ></svg>
            <!-- HTML member cards (Rendered via tree-nodes.ts) -->
            <div id="treeNodes"></div>
          </div>
        </div>

        <!-- Pan / Zoom controls Component -->
        <TreeControls />
      </div>

      <!-- FLOATING HOVER CARD -->
      <div id="ftHoverCard" class="ft-hover-card" style="display:none"></div>

      <!-- MOBILE SUMMARY Component (shown when tree-outer is hidden) -->
      <MobileSummary />

      <!-- FAMILY GRID SECTION Component -->
      <FamilyGrid />

    </div><!-- /.container -->
  </main>

  <!--
    Pass server-side data to the client-side module.
    define:vars serializes TREE_DATA as a global variable.
    The TypeScript orchestrator (main.ts) reads this on boot.
  -->
  <script define:vars={{ TREE_DATA }}>
    window.TREE_DATA = TREE_DATA;
  </script>

  <!-- Main TS Orchestrator -->
  <script>
    import '../scripts/family-tree/main';
  </script>

</Layout>
