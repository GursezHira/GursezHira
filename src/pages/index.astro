---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';
import MilestoneCard from '../components/MilestoneCard.astro';
import BlogCard from '../components/BlogCard.astro';
import LoveNote from '../components/LoveNote.astro';

const allMilestones = await getCollection('milestones');
const milestones = allMilestones.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()).slice(0, 3);

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()).slice(0, 3);
---

<Layout title="Home" image="/og/home.png">
  <main id="page-home" class="page active" aria-label="Home">
    
    <Hero />

    <StatsStrip />

    <div class="container">
      <!-- MILESTONES PREVIEW -->
      <section class="section" aria-label="Latest milestones">
        <div class="fade-up">
          <span class="section-label">Precious Moments</span>
          <h2 class="section-title">Latest <em>Milestones</em></h2>
          <p class="section-sub">A few of the beautiful firsts we never want to forget.</p>
        </div>
        <div class="milestones-preview-grid">
          {milestones.map((m) => (
            <MilestoneCard milestone={m} />
          ))}
        </div>
        <div style="text-align:center;margin-top:36px">
          <a href="/milestones" class="btn btn-soft">See All Milestones →</a>
        </div>
      </section>

      <LoveNote />

      <!-- BLOG PREVIEW -->
      <section class="section" aria-label="Recent posts">
        <div class="fade-up">
          <span class="section-label">From Our Hearts</span>
          <h2 class="section-title">Recent <em>Stories</em></h2>
          <p class="section-sub">Little letters to our little one.</p>
        </div>
        <div class="blog-preview-grid">
          {posts.map((p) => (
            <BlogCard post={p} />
          ))}
        </div>
        <div style="text-align:center;margin-top:36px">
          <a href="/stories" class="btn btn-soft">Read All Stories →</a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          revealObserver.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.fade-up').forEach(e => revealObserver.observe(e));
  });
</script>