---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allMilestonesRaw = await getCollection('milestones');
const ALL_MILESTONES = allMilestonesRaw.map(m => ({ ...m.data, id: m.id }));
---

<Layout 
  title="Milestones" 
  description="A timeline of all the beautiful firsts and tiny moments of Gursez Singh Hira."
  image="/og/home.png"
>
  <main id="page-milestones" class="page active" aria-label="Milestones">
    <div class="container">
      <div class="page-header fade-up">
        <span class="section-label">Every Beautiful First</span>
        <h1 class="section-title">Gursez's <em>Milestones</em></h1>
        <p class="section-sub" style="margin:0 auto">A timeline of all the tiny moments that filled our hearts to the brim.</p>
      </div>

      <!-- FILTER BAR -->
      <div class="filter-bar" role="search" aria-label="Filter milestones">
        <div class="filter-search">
          <input type="text" id="milestoneSearch" placeholder="Search milestones…" aria-label="Search milestones" />
        </div>
        <div class="filter-chips" role="group" aria-label="Category filters">
          <button class="filter-chip active" data-cat="all">All</button>
          <button class="filter-chip" data-cat="Firsts">Firsts</button>
          <button class="filter-chip" data-cat="Monthly">Monthly</button>
          <button class="filter-chip" data-cat="Growth">Growth</button>
          <button class="filter-chip" data-cat="Funny">Funny</button>
          <button class="filter-chip" data-cat="Health">Health</button>
          <button class="filter-chip" data-cat="Celebration">Celebration</button>
        </div>
        <div class="filter-sort">
          <select id="sortSelect" aria-label="Sort milestones">
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
          </select>
        </div>
      </div>

      <!-- TIMELINE -->
      <div class="timeline-wrap" aria-label="Milestone timeline">
        <div class="timeline-line" aria-hidden="true"></div>
        <div class="timeline-items" id="timelineItems"></div>
        <div class="load-more-trigger" id="loadMoreTrigger" aria-live="polite"></div>
        <div class="no-more" id="noMore" style="display:none">
          <span class="heart">🌸</span>
          All milestones lovingly loaded · more memories on the way
        </div>
      </div>
    </div>
  </main>

  <!-- MILESTONE MODAL -->
  <div class="modal-overlay" id="milestoneModal" role="dialog" aria-modal="true" aria-label="Milestone detail">
    <div class="modal-wrap">
      <div class="modal" id="modalContent"></div>
      <button class="modal-close" id="closeModalBtn" aria-label="Close">✕</button>
    </div>
  </div>

  <script define:vars={{ ALL_MILESTONES }}>
    let milestoneCategory = 'all';
    let milestoneSort = 'newest';
    let milestoneSearch = '';
    let loadedCount = 0;
    const BATCH = 5;
    let isLoading = false;
    let filteredMilestones = [];
    let curObserver = null;

    function getCategoryClass(cat) {
      const map = { Firsts: 'cat-firsts', Monthly: 'cat-monthly', Growth: 'cat-growth', Funny: 'cat-funny', Health: 'cat-health', Celebration: 'cat-celebration' };
      return map[cat] || 'cat-firsts';
    }

    function initMilestones() {
      milestoneSearch = '';
      document.getElementById('milestoneSearch').value = '';
      filterMilestones(true);
    }

    function getFilteredMilestones() {
      let list = ALL_MILESTONES.filter(m => {
        const matchCat = milestoneCategory === 'all' || m.category === milestoneCategory;
        const q = milestoneSearch.toLowerCase();
        const matchSearch = !q || m.title.toLowerCase().includes(q) || m.desc.toLowerCase().includes(q);
        return matchCat && matchSearch;
      });
      if (milestoneSort === 'oldest') list = list.sort((a, b) => new Date(a.date).valueOf() - new Date(b.date).valueOf());
      else list = list.sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
      return list;
    }

    function filterMilestones() {
      milestoneSort = document.getElementById('sortSelect').value;
      milestoneSearch = document.getElementById('milestoneSearch').value;
      loadedCount = 0;
      document.getElementById('timelineItems').innerHTML = '';
      document.getElementById('noMore').style.display = 'none';
      filteredMilestones = getFilteredMilestones();
      loadNextBatch();
    }

    document.getElementById('milestoneSearch').addEventListener('input', filterMilestones);
    document.getElementById('sortSelect').addEventListener('change', filterMilestones);

    document.querySelectorAll('.filter-chip').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
        e.target.classList.add('active');
        milestoneCategory = e.target.dataset.cat;
        loadedCount = 0;
        document.getElementById('timelineItems').innerHTML = '';
        document.getElementById('noMore').style.display = 'none';
        filteredMilestones = getFilteredMilestones();
        loadNextBatch();
      });
    });

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); revealObserver.unobserve(e.target); } });
    }, { threshold: 0.1 });

    function renderSkeletons(count) {
      const container = document.getElementById('timelineItems');
      for (let i = 0; i < count; i++) {
        const item = document.createElement('div');
        item.className = 'timeline-item visible sk-item';
        item.innerHTML = `
          <div class="tl-empty"></div>
          <div class="tl-center"><div class="tl-node" style="border-color:#e8d8d0">⋯</div></div>
          <div class="skeleton-card">
            <div class="skeleton-line sk-1"></div>
            <div class="skeleton-line sk-2"></div>
            <div class="skeleton-line sk-3"></div>
            <div class="skeleton-line sk-4"></div>
            <div class="skeleton-line sk-5"></div>
          </div>
        `;
        container.appendChild(item);
      }
    }

    function removeSkeletons() {
      document.querySelectorAll('.sk-item').forEach(s => s.remove());
    }

    window.openModal = function(mId) {
      const m = ALL_MILESTONES.find(x => x.id == mId || x.id == mId.toString());
      if (!m) return;
      document.getElementById('modalContent').innerHTML = `
        <div class="modal-img" style="background:${m.color}">${m.emoji}</div>
        <div class="modal-body">
          <span class="mpc-category ${getCategoryClass(m.category)} modal-category">${m.category}</span>
          <h2 class="modal-title">${m.title}</h2>
          <div class="modal-age-date">
            <span>👶 ${m.age}</span>
            <span>📅 ${m.displayDate}</span>
          </div>
          <div class="modal-desc">${m.desc}</div>
          <div class="modal-full-story">${m.story}</div>
        </div>
      `;
      document.getElementById('milestoneModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    function closeModalBtn() {
      document.getElementById('milestoneModal').classList.remove('open');
      document.body.style.overflow = '';
    }
    document.getElementById('closeModalBtn').addEventListener('click', closeModalBtn);
    document.getElementById('milestoneModal').addEventListener('click', (e) => {
      if (e.target === document.getElementById('milestoneModal')) closeModalBtn();
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModalBtn(); });

    function loadNextBatch() {
      if (isLoading) return;
      isLoading = true;
      const batch = Math.min(BATCH, filteredMilestones.length - loadedCount);
      if (batch <= 0) {
        document.getElementById('noMore').style.display = filteredMilestones.length ? 'block' : 'none';
        isLoading = false; return;
      }
      renderSkeletons(Math.min(batch, 3));

      setTimeout(() => {
        removeSkeletons();
        const container = document.getElementById('timelineItems');
        const slice = filteredMilestones.slice(loadedCount, loadedCount + batch);
        slice.forEach((m, i) => {
          const item = document.createElement('div');
          item.className = 'timeline-item';
          item.style.transitionDelay = (i * 0.08) + 's';
          item.innerHTML = `
            <div class="tl-empty"></div>
            <div class="tl-center"><div class="tl-node">${m.emoji}</div></div>
            <div class="tl-card" onclick="openModal('${m.id}')">
              <div class="tl-card-header">
                <div class="tl-card-title">${m.title}</div>
                <span class="mpc-category ${getCategoryClass(m.category)}">${m.category}</span>
              </div>
              <div class="tl-card-img" style="background:${m.color}">${m.emoji}</div>
              <div class="tl-card-desc">${m.desc}</div>
              <div class="tl-card-footer">
                <span class="tl-age">${m.age}</span>
                <span class="tl-date">${m.displayDate}</span>
              </div>
            </div>
          `;
          container.appendChild(item);
          setTimeout(() => revealObserver.observe(item), 50);
          setTimeout(() => item.classList.add('visible'), 100 + i * 80);
        });
        loadedCount += batch;
        isLoading = false;
        if (loadedCount >= filteredMilestones.length) {
          document.getElementById('noMore').style.display = 'block';
        }
      }, 500); // reduced delay for quicker UX
    }

    function setupInfiniteScroll() {
      if (curObserver) curObserver.disconnect();
      curObserver = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting && !isLoading) {
            loadNextBatch();
          }
        });
      }, { rootMargin: '200px' });
      curObserver.observe(document.getElementById('loadMoreTrigger'));
    }
    
    initMilestones();
    setupInfiniteScroll();
  </script>
</Layout>
